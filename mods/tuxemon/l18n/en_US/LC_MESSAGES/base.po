msgid "cosmic_berry"
msgstr "Flow State"

msgid "cosmic_berry_description"
msgstr "Changes a competitor's style to Flow."

msgid "earth_berry"
msgstr "Wrestling Tape"

msgid "earth_berry_description"
msgstr "Changes a competitor's style to Wrestling."

msgid "fire_berry"
msgstr "Boxing Gloves"

msgid "fire_berry_description"
msgstr "Changes a competitor's style to Striking."

msgid "frost_berry"
msgstr "Ice Bath"

msgid "frost_berry_description"
msgstr "Changes a competitor's style to Recovery."

msgid "heroic_berry"
msgstr "Gold Medal"

msgid "heroic_berry_description"
msgstr "Changes a competitor's style to Champion."

msgid "metal_berry"
msgstr "Pressure Passing Notes"

msgid "metal_berry_description"
msgstr "Changes a competitor's style to Pressure."

msgid "lightning_berry"
msgstr "Reaction Ball"

msgid "lightning_berry_description"
msgstr "Changes a competitor's style to Speed."

msgid "normal_berry"
msgstr "Fundamentals"

msgid "normal_berry_description"
msgstr "Changes a competitor's style to Balanced."

msgid "shadow_berry"
msgstr "Leg Lock Notes"

msgid "shadow_berry_description"
msgstr "Changes a competitor's style to Submission."

msgid "sky_berry"
msgstr "Flying Triangle Notes"

msgid "sky_berry_description"
msgstr "Changes a competitor's style to Dynamic."

msgid "venom_berry"
msgstr "Heel Hook Notes"

msgid "venom_berry_description"
msgstr "Changes a competitor's style to Aggressive."

msgid "water_berry"
msgstr "Guard Retention Notes"

msgid "water_berry_description"
msgstr "Changes a competitor's style to Guard."

msgid "wood_berry"
msgstr "Scramble Drill Notes"

msgid "wood_berry_description"
msgstr "Changes a competitor's style to Scrambler."

msgid "potion"
msgstr "White Monster"

msgid "potion_description"
msgstr "Restores a little energy. The official fuel of open mats."

msgid "super_potion"
msgstr "C4 Pre-Workout"

msgid "super_potion_description"
msgstr "An explosive energy boost. Side effects may include seeing red."

msgid "imperial_potion"
msgstr "Tren"

msgid "imperial_potion_description"
msgstr "You suddenly feel like entering every absolute division."

msgid "mega_potion"
msgstr "TRT Injection"

msgid "mega_potion_description"
msgstr "Clinically enhances your recovery. Doctor supervised... probably."

msgid "ancient_tea"
msgstr "John Danaher Instructional"

msgid "ancient_tea_description"
msgstr "Grants 4,500 XP to a teammate."

msgid "imperial_tea"
msgstr "BJJ Fanatics Mega Bundle"

msgid "imperial_tea_description"
msgstr "Years of knowledge in one purchase. Grants 10,000 XP to a teammate."

msgid "mystery_tea"
msgstr "YouTube Instructional"

msgid "mystery_tea_description"
msgstr "You learned something... probably. Grants 1,500 XP to a teammate."

msgid "tea"
msgstr "White Belt Notes"

msgid "tea_description"
msgstr "Study the basics. Grants 500 XP to a teammate."

msgid "revive"
msgstr "Smelling Salts"

msgid "revive_description"
msgstr "Gets you back on your feet after getting folded."

msgid "competitor_contract"
msgstr "Recruitment Invite"

msgid "competitor_contract_description"
msgstr "Recruits a competitor."

msgid "wrestler_contract"
msgstr "Wrestler Invite"

msgid "wrestler_contract_description"
msgstr "Works better on wrestling-style competitors."

msgid "striker_contract"
msgstr "Striker Invite"

msgid "striker_contract_description"
msgstr "Works better on striking-style competitors."

msgid "pressure_contract"
msgstr "Pressure Invite"

msgid "pressure_contract_description"
msgstr "Works better on pressure-heavy competitors."

msgid "guard_player_contract"
msgstr "Guard Player Invite"

msgid "guard_player_contract_description"
msgstr "Works better on guard-based competitors."

msgid "scrambler_contract"
msgstr "Scrambler Invite"

msgid "scrambler_contract_description"
msgstr "Works better on movement-based competitors."

msgid "male_competitor_contract"
msgstr "Male Competitor Invite"

msgid "male_competitor_contract_description"
msgstr "Works better on male competitors."

msgid "female_competitor_contract"
msgstr "Female Competitor Invite"

msgid "female_competitor_contract_description"
msgstr "Works better on female competitors."

msgid "trial_class_contract"
msgstr "Park Invite"

msgid "trial_class_contract_description"
msgstr "The official Park recruitment invite. It only works inside the Park."

msgid "open_division_contract"
msgstr "Open Division Invite"

msgid "open_division_contract_description"
msgstr "Works better on neutral/open-division competitors."

msgid "development_contract"
msgstr "Development Invite"

msgid "development_contract_description"
msgstr "Recruit a competitor and boost their level by 1."

msgid "premium_contract"
msgstr "Premium Invite"

msgid "premium_contract_description"
msgstr ""
"The ultimate recruitment tool, with a much higher success rate than the "
"Noble Invite."

msgid "old_school_contract"
msgstr "Ancient Invite"

msgid "old_school_contract_description"
msgstr ""
"This invite was made long ago and can recruit any competitor without fail."

msgid "pressure_contract_plus"
msgstr "Pressure Invite Plus"

msgid "pressure_contract_plus_description"
msgstr ""
"This invite breaks through defenses and works better against high-defense "
"competitors. It fails if a protective condition is active."

msgid "outsider_contract"
msgstr "Outsider Invite"

msgid "outsider_contract_description"
msgstr ""
"This odd invite works better if the opposing competitor is a different style "
"than yours, but worse if they share your style."

msgid "mirror_contract"
msgstr "Mirror Invite"

msgid "mirror_contract_description"
msgstr ""
"This odd invite works better if the opposing competitor shares your style, "
"but worse if they are different."

msgid "durable_contract"
msgstr "Durable Invite"

msgid "durable_contract_description"
msgstr "Recruits a competitor and does not break when it fails."

msgid "hearty_contract"
msgstr "Hearty Invite"

msgid "hearty_contract_description"
msgstr "Upon recruitment, the competitor's positive focus changes to hearty."

msgid "peppy_contract"
msgstr "Peppy Invite"

msgid "peppy_contract_description"
msgstr "Upon recruitment, the competitor's positive focus changes to peppy."

msgid "refined_contract"
msgstr "Refined Invite"

msgid "refined_contract_description"
msgstr "Upon recruitment, the competitor's positive focus changes to refined."

msgid "salty_contract"
msgstr "Salty Invite"

msgid "salty_contract_description"
msgstr "Upon recruitment, the competitor's positive focus changes to salty."

msgid "zesty_contract"
msgstr "Zesty Invite"

msgid "zesty_contract_description"
msgstr "Upon recruitment, the competitor's positive focus changes to zesty."

msgid "black_belt_contract"
msgstr "Grand Invite"

msgid "black_belt_contract_description"
msgstr "Offers an even higher recruitment rate than the Premium Invite."

msgid "coral_belt_contract"
msgstr "Majestic Invite"

msgid "coral_belt_contract_description"
msgstr "The highest recruitment rate of all, best for elusive competitors."

msgid "noble_contract"
msgstr "Noble Invite"

msgid "noble_contract_description"
msgstr ""
"A moderate upgrade to the standard Recruitment Invite, offering a reliable "
"recruitment rate."

msgid "day_class_contract"
msgstr "Daytime Invite"

msgid "day_class_contract_description"
msgstr ""
"Captures more easily during daytime, but its effectiveness is "
"significantly \n"
"reduced during the night."

msgid "night_class_contract"
msgstr "Night Invite"

msgid "night_class_contract_description"
msgstr ""
"Captures more easily during nighttime, but its effectiveness is \n"
"significantly reduced during the day."

msgid "open_mat_contract"
msgstr "Wildcard Invite"

msgid "open_mat_contract_description"
msgstr ""
"This invite is unpredictable. Its recruitment rate fluctuates wildly, from "
"extremely low to exceptionally high."

msgid "boost_armour"
msgstr "Boost Armor"

msgid "boost_armour_description"
msgstr "For the rest of the combat, increase Armor by two stages."

msgid "boost_dodge"
msgstr "Boost Dodge"

msgid "boost_dodge_description"
msgstr "For the rest of the combat, increase Dodge by two stages."

msgid "boost_melee"
msgstr "Boost Melee"

msgid "boost_melee_description"
msgstr "For the rest of the combat, increase Melee by two stages."

msgid "boost_ranged"
msgstr "Boost Ranged"

msgid "boost_ranged_description"
msgstr "For the rest of the combat, increase Ranged by two stages."

msgid "boost_speed"
msgstr "Boost Speed"

msgid "boost_speed_description"
msgstr "For the rest of the combat, increase Speed by two stages."

msgid "raise_armour"
msgstr "Raise Armor"

msgid "raise_armour_description"
msgstr "Learn the hardness of the diamond. Increase Armor by 5%."

msgid "raise_dodge"
msgstr "Raise Dodge"

msgid "raise_dodge_description"
msgstr "Learn the iridescence of the opal. Increase Dodge by 5%."

msgid "raise_hp"
msgstr "Raise HP"

msgid "raise_hp_description"
msgstr "Learn the bulk and abundance of quartz. Increase HP by 5%."

msgid "raise_melee"
msgstr "Raise Melee"

msgid "raise_melee_description"
msgstr "Learn the anger of the ruby. Increase Melee by 5%."

msgid "raise_ranged"
msgstr "Raise Ranged"

msgid "raise_ranged_description"
msgstr "Learn the aim of the emerald. Increase Ranged by 5%."

msgid "raise_speed"
msgstr "Raise Speed"

msgid "raise_speed_description"
msgstr "Learn the reflexes of the spinel. Increase Speed by 5%."

msgid "alpha_seep"
msgstr "Alpha Seep"

msgid "alpha_seep_description"
msgstr ""
"Thick, mucosal secretion harvested from the scent glands of apex predators \n"
"at the peak of their territorial cycle."

msgid "fishing_rod"
msgstr "Fishing Rod"

msgid "fishing_rod_description"
msgstr "Catch fish."

msgid "poseidon"
msgstr "Poseidon"

msgid "poseidon_description"
msgstr "Professional fishing rod."

msgid "neptune"
msgstr "Neptune"

msgid "neptune_description"
msgstr "Advanced fishing rod."

msgid "hatchet"
msgstr "Mat Cutter"

msgid "hatchet_description"
msgstr "Cut through obstacles blocking the path."

msgid "surfboard"
msgstr "Electric Scooter"

msgid "surfboard_description"
msgstr "From your Mom. It lets you travel faster."

msgid "gold_pass"
msgstr "VIP Academy Pass"

msgid "gold_pass_description"
msgstr "Enjoy the academy's deluxe services."

msgid "dojo_pass"
msgstr "Seminar Pass"

msgid "dojo_pass_description"
msgstr "Admit one to the Academy of Styles."

msgid "book_wishes"
msgstr "Book of Wishes"

msgid "book_wishes_description"
msgstr "The Achievement Maniac's list of achievements for you to attempt."

msgid "earthmover_key"
msgstr "Maintenance Key"

msgid "earthmover_key_description"
msgstr "Could come in handy if heavy equipment is blocking the path."

msgid "sledgehammer"
msgstr "Heavy Kettlebell"

msgid "sledgehammer_description"
msgstr "Smash apart gray boulders."

msgid "shammer_fossil"
msgstr "Shammer Fossil"

msgid "shammer_fossil_description"
msgstr "It looks like the skull of an ancient dog, but it's hard as stone."

msgid "rhincus_fossil"
msgstr "Rhincus Fossil"

msgid "rhincus_fossil_description"
msgstr "It looks like the skull of a toothed bird, but it's hard as stone."

msgid "nu_phone"
msgstr "Gym Phone"

msgid "nu_phone_description"
msgstr "You can do a lot with this, including phone home."

msgid "bivouac"
msgstr "Bivouac"

msgid "bivouac_description"
msgstr "Rest as if you were at a proper healing center. Consumed on use."

msgid "drone"
msgstr "Drone"

msgid "drone_description"
msgstr "Switch one teammate on your active squad with one in storage."

msgid "spyder_pass"
msgstr "Spyder Security Pass"

msgid "spyder_pass_description"
msgstr ""
"Grants access to restricted Spyder areas.This should let you in to places "
"only Spyder conspirators are meant to go."

msgid "app_radio"
msgstr "Podcast App"

msgid "app_radio_description"
msgstr ""
"Listen to gym gossip, interviews, and training tips.Tune in to local "
"broadcasts, quest updates, and ambient chatter from across the region."

msgid "app_banking"
msgstr "Bank App"

msgid "app_banking_description"
msgstr "Access your funds here whenever you're in town."

msgid "app_contacts"
msgstr "Training Partners App"

msgid "app_contacts_description"
msgstr "Call your friends and challenge people to a match."

msgid "app_map"
msgstr "Academy Map App"

msgid "app_map_description"
msgstr "Use this on your phone to see where you are."

msgid "app_renaming"
msgstr "Nickname App"

msgid "app_renaming_description"
msgstr ""
"Rename your competitors.Give your competitor a fresh identity with a new "
"name — make it truly yours!"

msgid "app_tuxepedia"
msgstr "Competitor Database App"

msgid "app_tuxepedia_description"
msgstr ""
"Review competitor info, styles, and records.Keep track of competitor "
"information here, and share it with the world."

msgid "p_trepidation"
msgstr "Trepidation"

msgid "p_trepidation_description"
msgstr ""
"Painting 'Trepidation', medium: oil on canvas. Hand-signed by the artist."

msgid "p_starry_night"
msgstr "Starry Night"

msgid "p_starry_night_description"
msgstr ""
"Painting 'Starry, Starry, Starry Night', medium: oil on canvas. Hand-"
"signed \n"
"by the artist."

msgid "p_monsters_eyes"
msgstr "Eyes Meet"

msgid "p_monsters_eyes_description"
msgstr ""
"Painting 'Eyes Meet', medium: oil on canvas. Hand-signed by the artist."

msgid "ancient_egg"
msgstr "Ancient Egg"

msgid "ancient_egg_description"
msgstr "A peculiar egg. If you plant it, maybe it will hatch."

msgid "restoration"
msgstr "Açaí Bowl"

msgid "restoration_description"
msgstr "Fully restores health and clears all ailments."

msgid "cureall"
msgstr "Recovery Day"

msgid "cureall_description"
msgstr "Sleep, food and mobility. Miraculous."

msgid "escape_key"
msgstr "Back Door Key"

msgid "escape_key_description"
msgstr "Slip out the back door."

msgid "unknown_object"
msgstr "Unknown Object"

msgid "unknown_object_description"
msgstr "Unknown origin and use. Must be identified before being applied."

msgid "bite_of_despair"
msgstr "Bite Of Despair"

msgid "bite_of_despair_description"
msgstr "Its scent hits first. Then the flavor finishes the job mercilessly."

msgid "whispersoup"
msgstr "Whispersoup"

msgid "whispersoup_description"
msgstr "The ladle trembles as you serve. No one speaks of what happened next."

msgid "inferno_custard"
msgstr "Inferno Custard"

msgid "inferno_custard_description"
msgstr "Too hot to eat. Too cursed to ignore. The bowl crackles with regret."

msgid "dread_omelette"
msgstr "Dread Omelette"

msgid "dread_omelette_description"
msgstr "It defies the laws of texture and taste. Even your utensils rebel."

msgid "meal_dust"
msgstr "Meal Dust"

msgid "meal_dust_description"
msgstr ""
"A fine blend of skyfield grains crushed under moonlight. Flexible, \n"
"lightweight, and essential to anything baked, folded, or fried."

msgid "sweetroot"
msgstr "Sweetroot"

msgid "sweetroot_description"
msgstr ""
"Glowing tubers harvested from whispering forest hollows. Sweet and mellow \n"
"with a hint of citrus zingâ€”ideal for desserts or tangy toppings."

msgid "mistflour_eggs"
msgstr "Mistflour Eggs"

msgid "mistflour_eggs_description"
msgstr ""
"Mysterious eggs laid by cloud roosting avians. Soft-shelled and full of \n"
"magical air, they fluff and bind dishes like a dream."

msgid "suncrust_butter"
msgstr "Suncrust Butter"

msgid "suncrust_butter_description"
msgstr ""
"Golden-rich cream pressed from sun-petal blooms. Warm, smooth, and faintly \n"
"herbalâ€”used to soften, shine, and enrich any dish."

msgid "crackle_salt"
msgstr "Crackle Salt"

msgid "crackle_salt_description"
msgstr ""
"Sparkling minerals mined in echoing caves. Adds bite and shimmer to savory \n"
"recipes, and sometimes pops mid-bite!"

msgid "starpepper"
msgstr "Starpepper"

msgid "starpepper_description"
msgstr ""
"Tiny glowing berries that ripen only under starlight. Fiery but sweet, "
"they \n"
"burn with a warmth that tickles rather than scorches."

msgid "sky_feather"
msgstr "Sky Feather"

msgid "sky_feather_description"
msgstr ""
"Plucked from the molting of breezebirds after migration. Delicate, light, \n"
"and a crisp favorite for peppy platings."

msgid "stonefruit_bulbs"
msgstr "Stonefruit Bulbs"

msgid "stonefruit_bulbs_description"
msgstr ""
"Hearty root-plants from volcanic valleys. Firm like meat, flavorful like \n"
"mushroom, and deeply satisfying."

msgid "field_greens"
msgstr "Field Greens"

msgid "field_greens_description"
msgstr ""
"Wild leaves that shift color with the wind. Bright, peppery, and often "
"eaten\n"
" freshâ€”or warmed just enough to curl."

msgid "beastmoss"
msgstr "Beastmoss"

msgid "beastmoss_description"
msgstr ""
"Thick moss found clinging to ancient creatures and sacred stones. Chewy, \n"
"earthy, and perfect in flakey wraps or hearty pies."

msgid "glowfat"
msgstr "Glowfat"

msgid "glowfat_description"
msgstr ""
"Rendered oil from luminous vines or docile beastbloom. Silky texture with "
"a \n"
"buttery aromaâ€”used for cooking or glazing."

msgid "moo_bloom"
msgstr "Moo Bloom"

msgid "moo_bloom_description"
msgstr ""
"Milky nectar tapped from docile meadow beasts. Smooth and comforting with \n"
"notes of honeygrass and sugarstem."

msgid "zestsap"
msgstr "Zestsap"

msgid "zestsap_description"
msgstr ""
"Electrified syrup drawn from zingfruit trees. Sharp, citrus-like and \n"
"wonderfully alive on the tongueâ€”used to wake up sleepy flavors."

msgid "zestroot_wraps"
msgstr "Zestroot Wraps"

msgid "zestroot_wraps_description"
msgstr ""
"Flexible shoots used as edible wrappers. Springy and infused with latent \n"
"spiceâ€”favored in soft, foldable dishes."

msgid "root_beast_bark"
msgstr "Root Beast Bark"

msgid "root_beast_bark_description"
msgstr ""
"Strips of hardened plant flesh shaped like ribs. Smoky and fibrous with a \n"
"primal umamiâ€”seasoned like a carnivore's dream, but plant-based."

msgid "flamehorn_shank"
msgstr "Flamehorn Shank"

msgid "flamehorn_shank_description"
msgstr ""
"Thick slices harvested from flamehorn floraâ€”giant, non-sentient "
"fireplants \n"
"cultivated for seared cuts. Bold, charred, and packed with bite."

msgid "spice_dust"
msgstr "Spice Dust"

msgid "spice_dust_description"
msgstr ""
"Crushed crystals infused with latent fire and zingfruit essence. Flickers "
"on\n"
" the tongue and wakes up any dish with a dazzling spark."

msgid "rub_pork_chops"
msgstr "Meal Prep Pork"

msgid "rub_pork_chops_description"
msgstr ""
"Protein-heavy meal prep for serious training.Root beast bark slices coated "
"in crackle dust. Smoky, spicy, and \n"
"fierceâ€”seasoned like primal meat, but purely plant-powered."

msgid "mille_feuille"
msgstr "Fancy Bakery Slice"

msgid "mille_feuille_description"
msgstr ""
"Looks expensive. Probably from the café near the academy.Layered pastry made "
"with mistflour and moo bloom cream. Rich, delicate, and \n"
"stacked with sweetness."

msgid "cheesecake"
msgstr "Post-Training Cheesecake"

msgid "cheesecake_description"
msgstr ""
"A questionable but morale-boosting recovery snack.Soft moo bloom cake with "
"glowfat swirl. Creamy and luxurious with a mellow \n"
"sparkle."

msgid "cream_puffs"
msgstr "Cream Puffs"

msgid "cream_puffs_description"
msgstr ""
"Light, sweet, and gone before warmups.Sweetroot puffs filled with enchanted "
"cream. Light, airy, and wickedly \n"
"indulgent."

msgid "crepes"
msgstr "Protein Crepes"

msgid "crepes_description"
msgstr ""
"Thin pancakes pretending to be healthy.Thin meal dust crepes wrapped around "
"shimmer filling. Graceful, sweet, and \n"
"just a little peppery."

msgid "rub_steak"
msgstr "Meal Prep Steak"

msgid "rub_steak_description"
msgstr ""
"Lean, expensive, and very serious.Flamehorn-style roast rubbed with spice "
"crystals. Bold, seared, and humming \n"
"with heat."

msgid "meatballs"
msgstr "Protein Meatballs"

msgid "meatballs_description"
msgstr ""
"Compact fuel for long open mats.Crumbled stonefruit bulb balls in zestsap "
"glaze. Hearty, tangy, and \n"
"magically satisfying."

msgid "shell_tacos"
msgstr "Tournament Tacos"

msgid "shell_tacos_description"
msgstr ""
"Risky before competition, perfect after.Field wrap tacos with zestroot "
"fillings and moo bloom sauce. Fresh, springy,\n"
" and packed with zip."

msgid "potato_casserole"
msgstr "Carb Load Casserole"

msgid "potato_casserole_description"
msgstr ""
"Heavy fuel for heavy rounds.Sweetroot and mistflour layers baked in zestsap. "
"Warm and citrusy with a \n"
"soft bite."

msgid "phyllo"
msgstr "Crispy Pastry"

msgid "phyllo_description"
msgstr ""
"Flaky, like your excuse for skipping cardio.Flaky wrap filled with tangy "
"beastmoss. Delicate layers with a bold, earthy \n"
"center."

msgid "croissants"
msgstr "Morning Croissants"

msgid "croissants_description"
msgstr ""
"Breakfast before the early fundamentals class.Buttery suncrust croissants "
"with zesty dust. Crisp, golden, and lightly \n"
"electrified."

msgid "rub_chicken"
msgstr "Meal Prep Chicken"

msgid "rub_chicken_description"
msgstr ""
"The official food of every competitor cutting weight.Sky feather cutlets "
"rubbed in starpepper mix. Light, crispy, and boldly \n"
"seasoned."

msgid "potato_fries"
msgstr "Post-Roll Fries"

msgid "potato_fries_description"
msgstr ""
"Salty recovery food after hard rounds.Sweetroot fries with magical salt "
"blend. Crunchy, glowing, and surprisingly \n"
"feisty."

msgid "pretzels"
msgstr "Mat-Side Pretzels"

msgid "pretzels_description"
msgstr ""
"Crunchy carbs between matches.Twisted field grain bites with starpepper "
"hints. Salty, chewy, and playfully\n"
" spicy."

msgid "mashed_potatoes"
msgstr "Carb Mash"

msgid "mashed_potatoes_description"
msgstr ""
"Soft, comforting, and suspiciously effective.Soft root mash with crackle "
"salt and moo bloom cream. Comforting with a \n"
"fizzy edge."

msgid "rub_ribs"
msgstr "BBQ Ribs"

msgid "rub_ribs_description"
msgstr ""
"Not competition-safe, but emotionally necessary.Stonefruit bulb ribs coated "
"in crackle spices. Meaty texture and satisfying \n"
"pop."

msgid "pie"
msgstr "Victory Pie"

msgid "pie_description"
msgstr ""
"Tastes better after a win.Golden pie crust filled with beastmoss stew. "
"Hearty, flaky, and deeply \n"
"savory."

msgid "honey_cake"
msgstr "Honey Protein Cake"

msgid "honey_cake_description"
msgstr ""
"Sweet fuel with just enough protein to justify it.Moist sweetroot cake "
"infused with shimmer dust. Sweet, spicy, and full of \n"
"bounce."

msgid "souffle"
msgstr "Fancy Souffle"

msgid "souffle_description"
msgstr ""
"Too delicate for the changing room.Airy glowfat soufflÃ© puffed with "
"zestsap. Light, tangy, and dreamlike on the\n"
" tongue."

msgid "hash"
msgstr "Breakfast Hash"

msgid "hash_description"
msgstr ""
"A greasy breakfast for the morning-after open mat.Warm hash of root veggies "
"and enchanted herbs. Earthy comfort with a peppery\n"
" kick."

msgid "pita"
msgstr "Chicken Pita"

msgid "pita_description"
msgstr ""
"Portable food for competitors on the move.Dry crispbread with a zesty spice "
"dust spread. Simple, snappy, and full of \n"
"flavor."

msgid "pastry"
msgstr "Gym Café Pastry"

msgid "pastry_description"
msgstr ""
"Bought with coffee and regret.Flaky pastry filled with a spicy sweetroot "
"swirl. Buttery folds with a \n"
"firecracker heart."

msgid "pudding"
msgstr "Açaí Pudding"

msgid "pudding_description"
msgstr ""
"Purple, sweet, and legally considered recovery.Creamy sweetroot pudding with "
"a tangy glow. Smooth and citrusy with a gentle\n"
" shimmer."

msgid "pancakes"
msgstr "Protein Pancakes"

msgid "pancakes_description"
msgstr ""
"Stacked like your excuses for avoiding stand-up.Fluffy sky-grain cakes "
"topped with shimmer zest. Soft, warm, and joyfully \n"
"bright."

msgid "wings"
msgstr "Post-Tournament Wings"

msgid "wings_description"
msgstr ""
"Best eaten after making weight.Crispy flying-beast style bites with magical "
"heat. Bold, sizzling, and bite-\n"
"sized bravery."

msgid "mystery_analyzer"
msgstr "Mystery Analyzer"

msgid "mystery_analyzer_description"
msgstr "A chunky scanner that beeps joyfully when decoding artifacts."

msgid "buzz_resonator"
msgstr "Buzz Resonator"

