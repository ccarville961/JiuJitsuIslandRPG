   </properties>
  </object>

  <object id="22" name="Coach Carville introduction" type="event" x="112" y="160" width="64" height="32">
   <properties>
    <property name="act10" value="char_stop player"/>
    <property name="act11" value="lock_controls"/>
    <property name="act12" value="pathfind player,6,11"/>
    <property name="act13" value="char_face player,up"/>
    <property name="act14" value="pathfind coach_carville,6,8"/>
    <property name="act15" value="char_face coach_carville,down"/>
