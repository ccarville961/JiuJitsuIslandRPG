    <property name="act18" value="translated_dialog coach_carville_intro2"/>
    <property name="act19" value="add_monster coach_carville,12,coach_carville,115,100"/>
    <property name="act20" value="set_variable coach_carville_battle:started"/>
    <property name="act21" value="start_battle player,coach_carville"/>
    <property name="act22" value="set_variable coach_carville_battle:return"/>
    <property name="cond1" value="is char_at player"/>
    <property name="cond2" value="not variable_set coach_carville_battle:started"/>
    <property name="cond3" value="not variable_set taba_master:defeated"/>
   </properties>
  </object>

  <object id="23" name="Coach Carville victory sequence" type="event" x="0" y="0" width="16" height="16">
   <properties>
    <property name="act10" value="wait 0.8"/>
    <property name="act11" value="lock_controls"/>
    <property name="act12" value="char_face coach_carville,down"/>
    <property name="act13" value="translated_dialog coach_carville_victory"/>
    <property name="act14" value="translated_dialog coach_carville_award"/>
    <property name="act15" value="add_item blue_belt"/>
    <property name="act16" value="play_sound sound_confirm"/>
    <property name="act17" value="set_variable badge:yes"/>
    <property name="act18" value="set_variable taba_master:defeated"/>
    <property name="act19" value="unlock_controls"/>
    <property name="act20" value="pathfind coach_carville,9,8"/>
    <property name="act21" value="char_face coach_carville,left"/>
    <property name="act22" value="unlock_controls"/>
    <property name="cond1" value="is variable_set coach_carville_battle:return"/>
    <property name="cond2" value="is battle_outcome player,won,coach_carville"/>
    <property name="cond3" value="not variable_set taba_master:defeated"/>
    <property name="cond4" value="not has_item player,blue_belt"/>
   </properties>
  </object>

